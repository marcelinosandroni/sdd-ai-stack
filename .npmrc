# ⚠️ NÃO commite um token aqui.
# Este arquivo é seguro para o git: usa variável de ambiente, não segredo literal.
# O token real é o secret NPM_TOKEN do repositório (ou $env:NPM_TOKEN na sua máquina).

registry=https://registry.npmjs.org/

# npm substitui ${NODE_AUTH_TOKEN} pelo valor da variável de ambiente.
# O workflow de release mapeia:  NODE_AUTH_TOKEN = secrets.NPM_TOKEN
//registry.npmjs.org/:_authToken=${NODE_AUTH_TOKEN}

# o pacote é público desde o primeiro publish (também há publishConfig no package.json)
access=public

# deve-se rodar `npm version` a partir de um repo git limpo; o CLI aborta se a
# working tree estiver suja, então não é preciso desligar essa checagem
