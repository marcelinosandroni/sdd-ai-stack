# ─────────────────────────────────────────────────────────────────
# NÃO coloque aqui nenhuma linha de `//registry.npmjs.org/:_authToken`.
#
# O npm lê os arquivos .npmrc nesta ordem (a última tem prioridade):
#   projeto  >  ~/.npmrc  (usuário)  >  npm global
#
# Então um `_authToken` aqui — mesmo sendo `${VARIAVEL_DE_AMBIENTE}` — SOBREPOE o
# token do seu ~/.npmrc. Se a variável estiver vazia, o resultado é um token vazio
# em todas as operações, e o sintoma é_confuso:
#   npm whoami  → 401 Unauthorized
#   npm publish → 404 Not Found (PUT)  ← parece "pacote não existe", mas é falta de auth
#
# A autenticação vem de:
#   - local:  ~/.npmrc ou `npm login` (sessão)
#   - CI:     variável de ambiente NODE_AUTH_TOKEN, injetada pelo release.yml
# ─────────────────────────────────────────────────────────────────

registry=https://registry.npmjs.org/

# o pacote é público desde o primeiro publish (publishConfig no package.json)
access=public
