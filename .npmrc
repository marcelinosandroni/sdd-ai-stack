# ─────────────────────────────────────────────────────────────────
# DO NOT put a `//registry.npmjs.org/:_authToken` line here.
#
# npm reads .npmrc in this order (later wins):
#   project  >  ~/.npmrc (user)  >  npm global
#
# So an `_authToken` here — even as `${AN_ENV_VAR}` — SHADOWS the token in your
# ~/.npmrc. With the variable empty the effective token is empty, and the symptom
# looks nothing like "auth is broken":
#   npm whoami  → 401 Unauthorized
#   npm publish → 404 Not Found (PUT)  ← looks like "the package doesn't exist", but it is missing auth
#
# Auth comes from:
#   - local:  ~/.npmrc or `npm login` (session)
#   - CI:     the NODE_AUTH_TOKEN environment variable, injected by release.yml
# ─────────────────────────────────────────────────────────────────

registry=https://registry.npmjs.org/

# ─────────────────────────────────────────────────────────────────
# GitHub Packages scope mapping.
#
# GitHub Packages ONLY accepts scoped packages (@owner/name). Our npm name is
# unscoped (`create-sdd-ai-stack`) so it publishes to npmjs; the release workflow
# rewrites the name to `@marcelinosandroni/create-sdd-ai-stack` for the GitHub step.
#
# A scope mapping only affects packages under that scope, so this line does NOT
# redirect the unscoped publish to GitHub Packages. It just tells npm where
# `@marcelinosandroni/*` lives, so `npm install @marcelinosandroni/…` resolves.
# ─────────────────────────────────────────────────────────────────
@marcelinosandroni:registry=https://npm.pkg.github.com
