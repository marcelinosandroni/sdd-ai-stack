{
  "name": "create-sdd-ai-stack",
  "version": "0.3.1",
  "description": "Cria um projeto pronto para agentes de IA com Spec-Driven Development: regras SDD + template Next.js 16 + design system.",
  "keywords": [
    "sdd",
    "spec-driven-development",
    "ai",
    "agent",
    "agents",
    "claude",
    "cursor",
    "nextjs",
    "template",
    "boilerplate",
    "scaffold"
  ],
  "homepage": "https://github.com/marcelinosandroni/sdd-ai-stack#readme",
  "bugs": {
    "url": "https://github.com/marcelinosandroni/sdd-ai-stack/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcelinosandroni/sdd-ai-stack.git"
  },
  "license": "MIT",
  "author": "Marcelino Sandroni <marcelino.sandroni@gmail.com>",
  "type": "module",
  "bin": {
    "create-sdd-ai-stack": "bin/create-sdd-ai-stack.mjs"
  },
  "main": "lib/scaffold.mjs",
  "exports": {
    ".": "./lib/scaffold.mjs",
    "./scaffold": "./lib/scaffold.mjs",
    "./constants": "./lib/constants.mjs",
    "./check-links": "./lib/check-links.mjs",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "files": [
    "bin",
    "src",
    "lib",
    "template/next",
    "template/next/package.json",
    "template/next/next.config.ts",
    "template/next/biome.json",
    "template/next/gitignore",
    "template/next/postcss.config.mjs",
    "template/next/tsconfig.json",
    "template/next/vitest.config.ts",
    "template/next/playwright.config.ts",
    "template/next/components.json",
    "template/next/.env.example",
    "template/next/public",
    "template/next/src",
    "template/next/tests",
    "!template/next/node_modules",
    "!template/next/.next",
    "!template/next/coverage",
    "!template/next/test-results",
    "!template/next/playwright-report",
    "!template/next/package-lock.json",
    "AGENTS.md",
    "APP.md",
    "APP-STACK.md",
    "ARCHITECTURE.md",
    "DESIGN.md",
    "stacks",
    "specs",
    "docs",
    "SKILLS",
    "README.md",
    "LICENSE",
    "PREFLIGHT.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.mjs",
    "test:unit": "npm run test",
    "check:coverage": "node SKILLS/check-coverage/check-coverage.mjs",
    "check:docs": "node SKILLS/check-docs/check-docs.mjs",
    "check:pack": "npm pack --dry-run",
    "version:patch": "npm version patch --git-tag-version",
    "version:minor": "npm version minor --git-tag-version",
    "version:major": "npm version major --git-tag-version",
    "prepublishOnly": "npm run test && npm run check:coverage && npm run check:rules && npm run check:docs && npm run check:facts && npm run check:pack",
    "check:rules": "node SKILLS/check-rules/check-rules.mjs",
    "check:facts": "node SKILLS/check-facts/check-facts.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "tests"
  }
}
